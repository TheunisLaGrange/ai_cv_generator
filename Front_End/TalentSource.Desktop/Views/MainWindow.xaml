<Window x:Class="TalentSource.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TalentSource - Production Deployment Dashboard" 
        Height="550" Width="980"
        Background="#1E1E1E"
        Icon="/Assets/app_icon.png"> 
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title block area -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Execute AI CV Customization Blueprint" 
                       Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Deterministic decoupled engine orchestration layer." 
                       Foreground="#888888" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Logging Output Viewport Box -->
        <Border Grid.Row="1" Background="#0C0C0C" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="4">
            <TextBox x:Name="TerminalLogBox"
                     Foreground="#00FF00" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="13" Margin="10"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        </Border>

        <!-- Execution Control Strip Layout -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="BypassCacheCheck" Content="Force Live API Request Execution Bypass (Ignore Cache Mode)" 
                      Foreground="#CCCCCC" VerticalAlignment="Center"/>

            <Button x:Name="OpenSpecButton" Grid.Column="1" 
                    Content="OPEN JOB SPECIFICATION" 
                    Width="200" Height="42" FontWeight="Bold" Margin="0,0,10,0"
                    Click="OpenSpecButton_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#1A365D"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate> <!-- 🔍 MAKE SURE THIS LINE IS INCLUDED -->
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Flat Styled Execution Control Button -->
            <Button x:Name="PipelineButton" Grid.Column="2" 
                    Content="RUN LIVE CUSTOMIZATION PIPELINE" 
                    Width="260" Height="42" FontWeight="Bold"
                    Click="PipelineButton_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#2A2A2A"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
